#include <stdio.h>
#include <stdlib.h>

#define MAX 20 // Maximum number of buildings

int adj[MAX][MAX];
int n = 0; // Actual number of buildings

// Add an undirected edge (path) between buildings
void addEdge(int u, int v) {
    if (u >= 0 && u < n && v >= 0 && v < n) {
        adj[u][v] = 1;
        adj[v][u] = 1; // Graph is undirected
        printf("Path added between Building %d and Building %d\n", u, v);
    } else {
        printf("Invalid building numbers!\n");
    }
}

// Breadth-First Search (Level by Level)
void BFS(int start) {
    if (start < 0 || start >= n) {
        printf("Invalid start building!\n");
        return;
    }
    int visited[MAX] = {0};
    int queue[MAX];
    int front = 0, rear = 0;

    visited[start] = 1;
    queue[rear++] = start;

    printf("BFS Traversal: ");
    while (front < rear) {
        int current = queue[front++];
        printf("%d ", current);

        for (int i = 0; i < n; i++) {
            if (adj[current][i] == 1 && !visited[i]) {
                visited[i] = 1;
                queue[rear++] = i;
            }
        }
    }
    printf("\n");
}

// Depth-First Search Helper (Recursive)
void DFS_Recursive(int current, int visited[]) {
    printf("%d ", current);
    visited[current] = 1;

    for (int i = 0; i < n; i++) {
        if (adj[current][i] == 1 && !visited[i]) {
            DFS_Recursive(i, visited);
        }
    }
}

// Depth-First Search Main Caller
void DFS(int start) {
    if (start < 0 || start >= n) {
        printf("Invalid start building!\n");
        return;
    }
    int visited[MAX] = {0};
    printf("DFS Traversal: ");
    DFS_Recursive(start, visited);
    printf("\n");
}

// Main menu
int main() {
    int choice, u, v, start;

    printf("Enter total number of buildings on campus (max %d): ", MAX);
    scanf("%d", &n);
    
    // Initialize adjacency matrix with 0 (no paths)
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            adj[i][j] = 0;
        }
    }

    while (1) {
        printf("\n--- Campus Navigation (Graph) ---\n");
        printf("1. Add Path (Edge)\n2. BFS Traversal\n3. DFS Traversal\n4. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Enter Building u and Building v (0 to %d): ", n - 1);
                scanf("%d %d", &u, &v);
                addEdge(u, v);
                break;
            case 2:
                printf("Enter starting building for BFS (0 to %d): ", n - 1);
                scanf("%d", &start);
                BFS(start);
                break;
            case 3:
                printf("Enter starting building for DFS (0 to %d): ", n - 1);
                scanf("%d", &start);
                DFS(start);
                break;
            case 4: return 0;
            default: printf("Invalid choice!\n");
        }
    }
}
